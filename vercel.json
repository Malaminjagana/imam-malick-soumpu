{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/llms.txt",
      "destination": "/public/llms.txt"
    },
    {
      "source": "/llms-full.txt",
      "destination": "/public/llms-full.txt"
    },
    {
      "source": "/ar",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/img/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}