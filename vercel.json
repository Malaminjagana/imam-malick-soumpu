{
  "cleanUrls": false,
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "imammalicksoumpu.com"
        }
      ],
      "destination": "https://www.imammalicksoumpu.com/$1",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/School-rolls.html",
      "destination": "/school-rolls.html"
    },
    {
      "source": "/llms.txt",
      "destination": "/public/llms.txt"
    },
    {
      "source": "/llms-full.txt",
      "destination": "/public/llms-full.txt"
    },
    {
      "source": "/ar",
      "destination": "/index.html"
    },
    {
      "source": "/biography/Muhammad-Kaba-Musa.html",
      "destination": "/biography/muhammad-kaba-musa.html"
    },
    {
      "source": "/biography/Ebrahim-Marry-Jagana.html",
      "destination": "/biography/ebrahim-marry-jagana.html"
    },
    {
      "source": "/biography/Malamin-zakaria-jagana.html",
      "destination": "/biography/malamin-zakaria-jagana.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/img/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}